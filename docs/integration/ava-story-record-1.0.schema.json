{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ava.local/schemas/ava-story-record-1.0.json",
  "title": "AVA Story Record",
  "description": "One citizen contribution, annotated and routed to a calibration parameter class. No raw text.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "revision",
    "created_at",
    "source",
    "consent",
    "time",
    "space",
    "channels",
    "routing",
    "observation",
    "dialog",
    "links",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "record_id": { "type": "string", "format": "uuid" },
    "revision": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "supersedes": {
      "type": ["string", "null"],
      "description": "record_id of the annotation this record replaces, or null"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref", "collected_at", "medium", "language"],
      "properties": {
        "kind": {
          "enum": ["request_311", "assisted_story", "interview", "panel", "operator_feed"]
        },
        "ref": {
          "type": "string",
          "description": "opaque pointer into the story store, never the text itself"
        },
        "collected_at": { "type": "string", "format": "date-time" },
        "medium": { "enum": ["text", "voice_transcript", "form", "sensor"] },
        "language": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" }
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["geolocation", "granularity", "calibration_use", "regime", "licence"],
      "properties": {
        "geolocation": { "type": "boolean" },
        "granularity": { "enum": ["h3_r7", "h3_r8", "h3_r9", "city"] },
        "calibration_use": { "enum": ["granted", "denied"] },
        "regime": { "enum": ["socio_narrative", "journalistic", "touristic"] },
        "licence": { "type": "string" }
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_at", "precision", "day_type", "service_period"],
      "properties": {
        "observed_at": { "type": "string", "format": "date-time" },
        "precision": { "enum": ["minute", "hour", "day_part", "day"] },
        "day_type": { "enum": ["weekday", "weekend", "event", "holiday"] },
        "service_period": {
          "enum": ["am_peak", "midday", "pm_peak", "evening", "night"]
        },
        "valid_from": { "type": ["string", "null"], "format": "date-time" },
        "valid_to": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "space": {
      "type": "object",
      "additionalProperties": false,
      "required": ["h3", "zone_id", "network_element", "od_pair"],
      "properties": {
        "h3": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{15}$",
          "description": "null when consent.granularity is city or geolocation is false"
        },
        "zone_id": { "type": ["string", "null"] },
        "network_element": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["type", "id", "network_source"],
          "properties": {
            "type": { "enum": ["link", "stop", "station", "facility", "poi", "zone"] },
            "id": { "type": "string" },
            "network_source": { "type": "string" }
          }
        },
        "od_pair": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["origin", "destination"],
          "properties": {
            "origin": { "type": "string" },
            "destination": { "type": "string" }
          }
        }
      }
    },
    "channels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["critical_functional", "dramaturgical"],
      "properties": {
        "critical_functional": {
          "type": "object",
          "additionalProperties": false,
          "required": ["present", "problem_class", "severity", "abstract"],
          "properties": {
            "present": { "type": "boolean" },
            "problem_class": {
              "enum": [
                "vehicle_full",
                "boarding_denied",
                "waiting_excessive",
                "bunching",
                "punctuality",
                "infrastructure_condition",
                "incident",
                "works",
                "demand_volume",
                "activities_dropped",
                "access_lost",
                "mode_shift_stated",
                "habit_changed",
                "perceived_unsafe",
                "perceived_crowding",
                "other",
                "none"
              ]
            },
            "severity": { "type": "integer", "minimum": 1, "maximum": 5 },
            "frequency": { "enum": ["once", "occasional", "frequent", "daily"] },
            "abstract": {
              "type": "string",
              "maxLength": 400,
              "description": "de-identified one sentence, no names, no plates, no addresses"
            }
          }
        },
        "dramaturgical": {
          "type": "object",
          "additionalProperties": false,
          "required": ["narrative_layer", "valence", "arousal", "temporal_tension"],
          "properties": {
            "narrative_layer": {
              "enum": ["friction", "solitude", "solidarity", "discovery", "microcrisis"]
            },
            "valence": { "type": "number", "minimum": -1, "maximum": 1 },
            "arousal": { "type": "number", "minimum": -1, "maximum": 1 },
            "temporal_tension": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parameter_class",
        "parameter_key",
        "direction",
        "target",
        "confidence",
        "trust_level",
        "calibration_eligible",
        "override",
        "reason_short"
      ],
      "properties": {
        "parameter_class": {
          "enum": ["theta_OD", "theta_cap", "theta_evt", "theta_beh", "theta_pers", "theta_perc"]
        },
        "parameter_key": { "type": "string" },
        "direction": { "enum": ["increase", "decrease", "both"] },
        "target": { "enum": ["link", "stop", "station", "facility", "od_pair", "segment", "zone"] },
        "segment": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "label": { "type": "string" },
            "age_band": { "type": ["string", "null"] },
            "constraint": {
              "enum": ["shift_work", "care_duties", "reduced_mobility", "student", null]
            }
          }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "trust_level": { "enum": ["A", "B", "C", "D", "E"] },
        "calibration_eligible": { "type": "boolean" },
        "override": {
          "type": "boolean",
          "description": "false when trust_level is D or E: a weak signal may raise or flag, never lower an instrumented estimate"
        },
        "reason_short": { "type": "string", "maxLength": 200 },
        "rule_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12,
          "description": "row of the routing table that fired"
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "uncertainty", "weight", "decay", "clock"],
      "properties": {
        "value": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "enum": ["scalar", "range", "ordinal"] },
            "scalar": { "type": ["number", "null"] },
            "low": { "type": ["number", "null"] },
            "high": { "type": ["number", "null"] },
            "ordinal": { "enum": ["none", "mild", "significant", "severe", null] }
          }
        },
        "unit": { "type": "string" },
        "uncertainty": { "type": "number", "minimum": 0 },
        "weight": { "type": "number", "minimum": 0, "maximum": 1 },
        "decay": {
          "type": "object",
          "additionalProperties": false,
          "required": ["half_life_hours", "t_ref"],
          "properties": {
            "half_life_hours": { "type": "number", "exclusiveMinimum": 0 },
            "t_ref": { "type": "string", "format": "date-time" },
            "computed_at": { "type": "string", "format": "date-time" }
          }
        },
        "clock": { "enum": ["minute", "day", "week", "month"] }
      }
    },
    "dialog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "model_check"],
      "properties": {
        "state": {
          "enum": ["confirmed", "blind_spot", "silent_problem", "normal", "pending"]
        },
        "model_check": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["run_id", "baseline_id", "expected", "observed", "residual", "tolerance"],
          "properties": {
            "run_id": { "type": "string" },
            "baseline_id": { "type": "string" },
            "expected": { "type": "number" },
            "observed": { "type": "number" },
            "residual": { "type": "number" },
            "tolerance": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corroborating", "story_ids", "run_id", "scenario_id", "response_ref"],
      "properties": {
        "corroborating": { "type": "integer", "minimum": 0 },
        "story_ids": { "type": "array", "items": { "type": "string" } },
        "run_id": { "type": ["string", "null"] },
        "scenario_id": { "type": ["string", "null"] },
        "response_ref": {
          "type": ["string", "null"],
          "description": "right of reply, when an operator or institution is named"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annotator", "human_review", "review_notes"],
      "properties": {
        "annotator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["engine", "version", "confidence"],
          "properties": {
            "engine": { "enum": ["jev", "llm", "human"] },
            "version": { "type": "string" },
            "model_id": { "type": ["string", "null"] },
            "prompt_hash": { "type": ["string", "null"] },
            "primitive": { "enum": ["noul", "choice", "score", "match", "rerank", null] },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "human_review": { "type": "boolean" },
        "reviewer": { "type": ["string", "null"] },
        "reviewed_at": { "type": ["string", "null"], "format": "date-time" },
        "review_notes": { "type": ["string", "null"] }
      }
    }
  }
}
